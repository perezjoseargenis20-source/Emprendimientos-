@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap');

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Poppins', sans-serif;
}

body {
  background: linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.65)),
              url('https://images.unsplash.com/photo-1500937386664-56d1dfef3854?auto=format&fit=crop&w=1920&q=80') no-repeat center center fixed;
  background-size: cover;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 25px 15px 40px 15px;
}

/* CABECERA & LOGO */
.logo-box {
  background: rgba(255, 255, 255, 0.95);
  padding: 10px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10px 25px rgba(0,0,0,0.5);
  max-width: 420px;
  width: 90%;
  border: 3px solid #ffffff;
}

.logo-img {
  width: 100%;
  max-height: 200px;
  object-fit: cover;
  border-radius: 12px;
}

.slogan-principal {
  color: #ffffff;
  margin: 15px 0 25px 0;
  font-size: 1.2rem;
  font-style: italic;
  text-shadow: 2px 2px 8px rgba(0,0,0,0.8);
  text-align: center;
}

.titulo-seccion {
  color: #ffffff;
  font-size: 1.6rem;
  margin-bottom: 5px;
  text-align: center;
}

/* GALERÍA DE PRODUCTOS */
.galeria-productos {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 20px;
  width: 100%;
  max-width: 1200px;
  margin-bottom: 50px;
}

.tarjeta-producto {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16px;
  padding: 12px;
  position: relative;
  box-shadow: 0 10px 25px rgba(0,0,0,0.5);
  display: flex;
  flex-direction: column;
}

.etiqueta {
  position: absolute;
  top: 20px;
  left: 20px;
  background: #2d6a4f;
  color: #fff;
  font-size: 0.7rem;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 12px;
  z-index: 2;
}

.etiqueta.top {
  background: #e63946;
}

.contenedor-img {
  width: 100%;
  height: 150px;
  border-radius: 12px;
  overflow: hidden;
}

.contenedor-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.info-producto {
  margin-top: 12px;
  text-align: center;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.info-producto h3 {
  font-size: 1.05rem;
  color: #1b4332;
}

.info-producto p {
  font-size: 0.8rem;
  color: #555;
  margin-bottom: 15px;
  flex: 1;
}

.acciones-tarjeta {
  display: flex;
  gap: 8px;
}

.btn-detalle {
  background: #e9ecef;
  color: #1b4332;
  border: 1px solid #1b4332;
  padding: 8px 0;
  border-radius: 8px;
  font-weight: 700;
  font-size: 0.8rem;
  cursor: pointer;
  flex: 1;
  text-align: center;
  user-select: none;
  transition: background 0.2s;
}

.btn-detalle:hover {
  background: #d8f3dc;
}

.btn-comprar {
  background: #1b4332;
  color: #ffffff;
  text-decoration: none;
  padding: 8px 0;
  border-radius: 8px;
  font-weight: 700;
  font-size: 0.8rem;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* SECCIÓN DE RESEÑAS Y COMENTARIOS */
.seccion-resenas {
  width: 100%;
  max-width: 1200px;
  margin-bottom: 50px;
}

.subtitulo-resenas {
  color: #d8f3dc;
  text-align: center;
  font-size: 0.9rem;
  margin-bottom: 25px;
  text-shadow: 1px 1px 4px rgba(0,0,0,0.8);
}

.galeria-resenas {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px;
}

.tarjeta-resena {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.4);
}

.cabecera-resena {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
}

.foto-cliente {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid #2d6a4f;
}

.datos-cliente h4 {
  font-size: 0.95rem;
  color: #1b4332;
}

.estrellas {
  color: #ffb703;
  font-size: 0.85rem;
}

.comentario-cliente {
  font-size: 0.82rem;
  color: #444;
  line-height: 1.4;
  font-style: italic;
}

/* SECCIÓN DE DESPEDIDA Y RECOMENDACIÓN */
.seccion-despedida {
  width: 100%;
  max-width: 1200px;
  margin-bottom: 30px;
}

.caja-despedida {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20px;
  padding: 30px 25px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  text-align: center;
  border-top: 5px solid #2d6a4f;
}

.caja-despedida h3 {
  color: #1b4332;
  font-size: 1.4rem;
  margin-bottom: 12px;
}

.texto-futuro {
  color: #444;
  font-size: 0.9rem;
  line-height: 1.6;
  max-width: 850px;
  margin: 0 auto 20px auto;
}

.texto-futuro strong {
  color: #2d6a4f;
}

.tarjeta-recomendacion {
  background: #d8f3dc;
  border-left: 4px solid #1b4332;
  padding: 15px 20px;
  border-radius: 10px;
  text-align: left;
  display: flex;
  align-items: flex-start;
  gap: 12px;
  max-width: 850px;
  margin: 0 auto;
}

.icono-destacado {
  font-size: 1.4rem;
  line-height: 1;
}

.tarjeta-recomendacion p {
  color: #1b4332;
  font-size: 0.85rem;
  line-height: 1.5;
}

/* TRUCO CSS PARA VENTANAS EMERGENTES (MODALES SIN JS) */
.modal-state {
  display: none;
}

.modal-overlay {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.75);
  z-index: 100;
  justify-content: center;
  align-items: center;
  padding: 20px;
}

.modal-state:checked + .modal-overlay {
  display: flex;
}

.modal-contenido {
  background: #ffffff;
  padding: 20px;
  border-radius: 16px;
  max-width: 400px;
  width: 100%;
  position: relative;
  box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  animation: abrir 0.3s ease-out;
}

@keyframes abrir {
  from { transform: scale(0.8); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.btn-cerrar {
  position: absolute;
  top: 10px;
  right: 15px;
  font-size: 1.8rem;
  cursor: pointer;
  color: #888;
  line-height: 1;
}

.modal-img {
  width: 100%;
  height: 180px;
  object-fit: cover;
  border-radius: 12px;
  margin-bottom: 12px;
}

.modal-contenido h3 {
  color: #1b4332;
  font-size: 1.2rem;
  margin-bottom: 10px;
  text-align: center;
}

.modal-info p {
  color: #333;
  font-size: 0.85rem;
  margin-bottom: 8px;
  line-height: 1.4;
}

.precio-destacado {
  color: #2d6a4f;
  font-weight: 700;
}

.btn-cerrar-modal {
  display: block;
  width: 100%;
  background: #1b4332;
  color: #fff;
  border: none;
  padding: 10px 0;
  border-radius: 8px;
  font-weight: 700;
  margin-top: 10px;
  cursor: pointer;
  text-align: center;
  user-select: none;
}

/* BOTÓN WHATSAPP */
.btn-whatsapp {
  position: fixed;
  bottom: 20px;
  right: 20px;
  background: #25d366;
  width: 55px;
  height: 55px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 15px rgba(0,0,0,0.5);
  z-index: 99;
}

.btn-whatsapp svg {
  width: 30px;
  height: 30px;
}