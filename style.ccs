@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap');

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Poppins', sans-serif;
}

body {
  background: linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.65)),
              url('https://images.unsplash.com/photo-1500937386664-56d1dfef3854?auto=format&fit=crop&w=1920&q=80') no-repeat center center fixed;
  background-size: cover;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 25px 15px 0 15px;
}

/* MARCA Y LOGO */
.logo-box {
  background: rgba(255, 255, 255, 0.95);
  padding: 10px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10px 25px rgba(0,0,0,0.5);
  max-width: 450px;
  width: 90%;
  overflow: hidden;
  border: 3px solid #ffffff;
}

.logo-img {
  width: 100%;
  height: auto;
  max-height: 220px;
  object-fit: cover;
  border-radius: 12px;
}

.slogan-principal {
  color: #ffffff;
  margin: 20px 0 25px 0;
  font-size: 1.25rem;
  font-style: italic;
  text-shadow: 2px 2px 8px rgba(0,0,0,0.8);
  text-align: center;
}

.titulo-seccion {
  color: #ffffff;
  font-size: 1.6rem;
  margin-bottom: 20px;
  text-align: center;
  text-shadow: 2px 2px 6px rgba(0,0,0,0.7);
}

/* TARJETAS DE PRODUCTOS */
.galeria-productos {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 20px;
  width: 100%;
  max-width: 1200px;
  margin-bottom: 50px;
}

.tarjeta-producto {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16px;
  padding: 12px;
  position: relative;
  box-shadow: 0 10px 25px rgba(0,0,0,0.5);
  transition: transform 0.3s ease;
  display: flex;
  flex-direction: column;
}

.tarjeta-producto:hover {
  transform: translateY(-5px);
  background: #ffffff;
}

.etiqueta {
  position: absolute;
  top: 20px;
  left: 20px;
  background: #2d6a4f;
  color: #fff;
  font-size: 0.7rem;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 12px;
  z-index: 2;
}

.etiqueta.top {
  background: #e63946;
}

.contenedor-img {
  width: 100%;
  height: 150px;
  border-radius: 12px;
  overflow: hidden;
}

.contenedor-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.info-producto {
  margin-top: 12px;
  text-align: center;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.info-producto h3 {
  font-size: 1.05rem;
  color: #1b4332;
  margin-bottom: 4px;
}

.info-producto p {
  font-size: 0.8rem;
  color: #555;
  margin-bottom: 15px;
  flex: 1;
}

/* BOTONES DE LA TARJETA */
.acciones-tarjeta {
  display: flex;
  gap: 8px;
}

.btn-detalle {
  background: #e9ecef;
  color: #1b4332;
  border: 1px solid #1b4332;
  padding: 8px 0;
  border-radius: 8px;
  font-weight: 700;
  font-size: 0.8rem;
  cursor: pointer;
  flex: 1;
  transition: all 0.2s ease;
}

.btn-detalle:hover {
  background: #d8f3dc;
}

.btn-comprar {
  background: #1b4332;
  color: #ffffff;
  text-decoration: none;
  padding: 8px 0;
  border-radius: 8px;
  font-weight: 700;
  font-size: 0.8rem;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease;
}

.btn-comprar:hover {
  background: #40916c;
}

/* RESEÑAS */
.seccion-resenas {
  width: 100%;
  max-width: 1200px;
  margin-bottom: 50px;
}

.subtitulo-resenas {
  color: #d8f3dc;
  text-align: center;
  margin-top: -15px;
  margin-bottom: 30px;
  font-size: 0.95rem;
}

.rejilla-resenas {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px;
}

.tarjeta-resena {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
}

.resena-cabecera {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 12px;
}

.foto-usuario {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid #2d6a4f;
}

.resena-cabecera h4 {
  font-size: 1rem;
  color: #1b4332;
}

.estrellas {
  color: #f59e0b;
  font-size: 0.9rem;
}

.texto-resena {
  font-size: 0.88rem;
  color: #444;
  font-style: italic;
}

/* VENTANA MODAL INTERACTIVA (POP-UP) */
.modal-overlay {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.7);
  z-index: 100;
  justify-content: center;
  align-items: center;
  padding: 20px;
}

.modal-contenido {
  background: #ffffff;
  padding: 25px;
  border-radius: 16px;
  max-width: 450px;
  width: 100%;
  position: relative;
  box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  animation: aparecer 0.3s ease;
}

@keyframes aparecer {
  from { transform: scale(0.8); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.btn-cerrar {
  position: absolute;
  top: 15px;
  right: 20px;
  font-size: 1.5rem;
  cursor: pointer;
  color: #888;
}

.btn-cerrar:hover {
  color: #000;
}

.modal-contenido h3 {
  color: #1b4332;
  margin-bottom: 10px;
}

.linea-modal {
  border: 0;
  height: 2px;
  background: #2d6a4f;
  margin-bottom: 15px;
}

.modal-cuerpo p {
  color: #333;
  font-size: 0.9rem;
  margin-bottom: 12px;
  line-height: 1.4;
}

.precio-destacado {
  color: #2d6a4f;
  font-weight: 700;
  font-size: 1.05rem;
}

.btn-cerrar-modal {
  width: 100%;
  background: #1b4332;
  color: #fff;
  border: none;
  padding: 10px;
  border-radius: 8px;
  font-weight: 700;
  margin-top: 10px;
  cursor: pointer;
}

.btn-cerrar-modal:hover {
  background: #40916c;
}

/* BOTÓN WHATSAPP & FOOTER */
.btn-whatsapp {
  position: fixed;
  bottom: 20px;
  right: 20px;
  background: #25d366;
  width: 55px;
  height: 55px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 15px rgba(0,0,0,0.5);
  z-index: 99;
}

.btn-whatsapp svg {
  width: 30px;
  height: 30px;
}

.pie-pagina {
  margin-top: auto;
  width: 100vw;
  background: rgba(15, 32, 22, 0.95);
  padding: 20px 15px;
  text-align: center;
  border-top: 3px solid #2d6a4f;
}

.frase-motivacional {
  color: #b7e4c7;
  font-style: italic;
  font-size: 0.95rem;
}